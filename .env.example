# Application Configuration (Template)
# Do not place real credentials or secret keys in this file.

# Public / Client-Side Environment Variables (Exposed to browser via Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key-here"

# Server-Side Only Secrets (Never expose to client or browser bundles)
# For hosted Supabase Edge Functions: platform automatically provides SUPABASE_SECRET_KEYS JSON.
# For local development / self-hosted: configure JOHARI_SUPABASE_SECRET_KEY or SUPABASE_SECRET_KEY.
# Supports modern Supabase opaque secret keys (sb_secret_...) directly without JWT parsing.
JOHARI_SUPABASE_SECRET_KEY="sb_secret_your-secret-key-here"
SUPABASE_SECRET_KEY="sb_secret_your-secret-key-here"

# Application URL (Injected at runtime in Cloud Run / AI Studio preview)
APP_URL="http://localhost:3000"
